# Roboface 환경 변수 — 복사해서 .env로 저장 후 채우세요

# === 모드 ===
# simulator: PC에서 Pygame으로 얼굴만 띄움 (하드웨어 없음)
# robot: Pi 5 + 실제 하드웨어
ROBOFACE_MODE=simulator

# === Anthropic Claude API ===
ANTHROPIC_API_KEY=

# === ThinkTank 통합 ===
THINKTANK_BASE_URL=http://localhost:3001
THINKTANK_ROBOT_TOKEN=

# === 로깅 ===
LOG_LEVEL=INFO

# === 음성 ===
# OpenAI Whisper(STT) + OpenAI TTS 사용 (option 1: 추천 조합)
OPENAI_API_KEY=

# Picovoice Porcupine wake word (무료 발급: https://console.picovoice.ai)
PORCUPINE_ACCESS_KEY=
# 빌트인 키워드 (jarvis / computer / hey google / ...) — 한국어는 .ppn 파일 경로 지정
PORCUPINE_KEYWORD=jarvis
# PORCUPINE_KEYWORD_PATH=/home/miro/roboface/data/wake_words/안녕로보_ko_raspberry-pi.ppn

# 마이크 디바이스 (USB 스피커폰). 비워두면 시스템 기본
# `python -c "import sounddevice; print(sounddevice.query_devices())"` 로 확인
# AUDIO_INPUT_DEVICE=

# === ElevenLabs (선택 — 더 자연스러운 TTS 원할 때) ===
# ELEVENLABS_API_KEY=
