# Roboface 환경 변수 — 복사해서 .env로 저장 후 채우세요

# === 모드 ===
# simulator: PC에서 Pygame으로 얼굴만 띄움 (하드웨어 없음)
# robot: Pi 5 + 실제 하드웨어
ROBOFACE_MODE=simulator

# === Anthropic Claude API ===
ANTHROPIC_API_KEY=

# === ThinkTank 통합 ===
THINKTANK_BASE_URL=http://localhost:3001
THINKTANK_ROBOT_TOKEN=

# === 로깅 ===
LOG_LEVEL=INFO

# === 음성 (Phase 4 이후) ===
# OPENAI_API_KEY=          # 선택, Whisper API
# ELEVENLABS_API_KEY=      # 선택, TTS
